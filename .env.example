# Copy to .env and fill in. Never commit .env.

# --- Stripe (sandbox / test mode only) ---
# Secret key from the Stripe Dashboard in a sandbox (sk_test_...). Only needed for
# scripts/create_checkout_session.py; the webhook receiver itself never calls Stripe.
STRIPE_API_KEY=
# Webhook signing secret. For the Stripe CLI path, paste the whsec_... printed by
# `stripe listen --print-secret`. For the fully offline path any non-empty value works,
# because the offline simulator signs its requests with this same secret.
STRIPE_WEBHOOK_SECRET=whsec_offline_demo_only_not_a_real_secret

# --- App ---
DATABASE_PATH=data/webhook_sync.db
# Base URL of the downstream order service the worker syncs to. Defaults to the
# mock order service mounted inside this app at /mock-oms.
ORDER_API_BASE_URL=http://127.0.0.1:8000/mock-oms
ORDER_API_TIMEOUT_SECONDS=2
# Seconds the mock order service stalls when a "timeout" fault is injected.
MOCK_OMS_STALL_SECONDS=4

# --- Worker / retry policy ---
WORKER_ENABLED=true
WORKER_POLL_SECONDS=0.5
MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=1
RETRY_MAX_SECONDS=30

# Enables the dashboard's offline simulator + fault injection. Disable outside demos.
ENABLE_SIMULATOR=true
